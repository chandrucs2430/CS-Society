# ==============================================================================
# CS Society - Environment Variables Configuration
# ==============================================================================
# Copy this file to .env before building:
#   Copy-Item .env.example .env (Windows PowerShell)
#   cp .env.example .env        (macOS / Linux)
#
# Obtain these values from your Supabase Dashboard:
#   Project Settings -> API
# ==============================================================================

# Required: Public Supabase Project URL (HTTPS)
# Supported aliases: VITE_SUPABASE_URL, SUPABASE_URL, NEXT_PUBLIC_SUPABASE_URL
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Required: Public Anon / Publishable API Key
# Supported aliases: VITE_SUPABASE_ANON_KEY, SUPABASE_ANON_KEY, NEXT_PUBLIC_SUPABASE_ANON_KEY
# WARNING: This MUST be the public anon/publishable key.
# The build script strictly verifies this and will abort if a service-role key is provided.
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Optional: Server-side Service-Role Key (For administrative maintenance only)
# CRITICAL SECURITY NOTE:
# This key has full administrative bypass of Row Level Security.
# It is NEVER bundled or exposed to the browser.
# Leave blank unless running server-side admin scripts out-of-band.
# SUPABASE_SERVICE_ROLE_KEY=your-secret-service-role-key
